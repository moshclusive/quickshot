<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <AssemblyName>QuickShot</AssemblyName>
    <RootNamespace>QuickShot</RootNamespace>
    <Product>QuickShot</Product>
    <Version>1.0.0</Version>
    <Company>QuickShot</Company>
    <Description>Lightweight Screenshot, GIF Recorder &amp; Any-Language OCR Studio</Description>
    <ApplicationIcon>assets\Icon\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWindowsForms>true</UseWindowsForms>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Runtime.WindowsRuntime">
      <HintPath>C:\Windows\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.WindowsRuntime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Foundation">
      <HintPath>C:\Windows\System32\WinMetadata\Windows.Foundation.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Globalization">
      <HintPath>C:\Windows\System32\WinMetadata\Windows.Globalization.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Graphics">
      <HintPath>C:\Windows\System32\WinMetadata\Windows.Graphics.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Media">
      <HintPath>C:\Windows\System32\WinMetadata\Windows.Media.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Storage">
      <HintPath>C:\Windows\System32\WinMetadata\Windows.Storage.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\Icon\**\*" />
    <EmbeddedResource Include="assets\Tools\**\*" />
    <EmbeddedResource Include="assets\Fonts\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\Tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tessdata\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RemoveUnusedNativeFolders" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)x86" Condition="Exists('$(OutDir)x86')" />
    <RemoveDir Directories="$(OutDir)runtimes\win-x86" Condition="Exists('$(OutDir)runtimes\win-x86')" />
    <RemoveDir Directories="$(OutDir)runtimes\win-arm64" Condition="Exists('$(OutDir)runtimes\win-arm64')" />
  </Target>
</Project>
